# DrCOM auto login service (procd managed)
#
# The login logic lives in /usr/share/drcom/drcom.sh and reads
# /etc/config/drcom itself.  This script only decides when to run it:
#
#   - boot:      start only when uci drcom.main.enabled = 1
#   - manual:    start/restart always work, regardless of that option
#
# Keeping the two paths separate avoids the "start says ok but nothing
# happened" trap when the service is not marked as enabled.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/share/drcom/drcom.sh

boot() {
	config_load drcom
	config_get_bool enabled main enabled 0

	[ "$enabled" = "1" ] || return 0

	start
}

start_service() {
	[ -x "$PROG" ] || {
		logger -t drcom -p user.err "missing or non-executable $PROG"
		return 1
	}

	procd_open_instance
	procd_set_param command /bin/sh "$PROG" run
	# threshold=3600s, timeout=5s, retry=5 times, then give up
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	# restart the instance when the UCI config changes
	procd_set_param file /etc/config/drcom
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "drcom"
}

reload_service() {
	stop
	start
}
